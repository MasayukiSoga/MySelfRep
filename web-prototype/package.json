{
  "name": "myselfrep-ts-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "../src/MySelfRep のドメインモデルを写した一時的な TypeScript 試作。C# へ移植する前にブラウザで動作確認するためのもの",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/app.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
