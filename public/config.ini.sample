; ------------------------------------------------------------------
; config.ini.sample を config.ini にコピーして値を埋めてください。
; アップロード後は必ず chmod 600 config.ini を実行すること。
; ------------------------------------------------------------------

[database]
; さくらのサーバコントロールパネル「データベース」に表示される値
host = mysqlXXX.db.sakura.ne.jp
port = 3306
name = yourname_game
user = yourname
password =

[app]
; 画面に出すアプリ名
title = ゲーム情報管理

; Cookie の署名に使う秘密鍵。tools/make_secrets.py で生成できる。
; 空のままだと private/secret.key を自動生成して使う。
secret_key =

; 新規登録を受け付けるか。全員の登録が済んだら false にすると登録を閉じられる。
allow_signup = true

; 招待コード。これを知っている人だけがアカウントを作成できる。
; tools/make_secrets.py で生成するか、推測されにくい文字列を自分で決める。
; 最初に登録した人が自動的に管理者になる。
invite_code =

; 一覧 1 ページあたりの件数（5〜100）
per_page = 20

; 起動時に users / games テーブルが無ければ自動作成する
auto_migrate = true
