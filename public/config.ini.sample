; ------------------------------------------------------------------
; config.ini.sample を config.ini にコピーして値を埋めてください。
; アップロード後は必ず chmod 600 config.ini を実行すること。
; ------------------------------------------------------------------

[database]
; さくらのサーバコントロールパネル「データベース」に表示される値
host = mysqlXXX.db.sakura.ne.jp
port = 3306
name = yourname_game
user = yourname
password =

[app]
; 画面に出すアプリ名
title = ゲーム情報管理

; Cookie の署名に使う秘密鍵。tools/make_password.py で生成できる。
; 空のままだと private/secret.key を自動生成して使う。
secret_key =

; ログイン必須にするか（インターネット公開時は必ず true）
login_required = true

; ログインパスワード。どちらか一方を設定する。
;   password_hash … tools/make_password.py が出力する文字列（推奨）
;   password      … 平文（お試し用。設定すると画面に警告が出る）
password_hash =
password =

; 一覧 1 ページあたりの件数
per_page = 20

; 起動時に games テーブルが無ければ自動作成する
auto_migrate = true
